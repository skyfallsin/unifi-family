"""
unifi-family — a small CLI over the official UniFi Network Integration API
(v11.0.97) for allowing/blocking websites per device (built for managing kids'
devices).

Works two ways:
  * Local console:  base_url = https://<gateway-ip>   (LAN only)
  * Cloud (ui.com): base_url = https://api.ui.com  +  console_id
    (uses the UI Site Manager key; works from anywhere)

Config is read from (first wins):
  1. CLI flags --base-url / --api-key / --site
  2. Environment: UNIFI_BASE_URL, UNIFI_API_KEY, UNIFI_SITE
  3. ~/.config/unifi/config.json  {"base_url":..., "api_key":..., "site":...,
                                    "verify_tls": false}

base_url examples:
  Local console:  https://192.168.1.1   (the CLI appends /proxy/network/integration)
  Cloud connector: pass the full host and set --console-id, or just use local.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import textwrap
from pathlib import Path

try:
    import requests
except ImportError:
    sys.exit("This CLI needs the 'requests' package. Install with: pip install requests")

import urllib3

CONFIG_PATH = Path(os.path.expanduser("~/.config/unifi/config.json"))
MEMBERS_PATH = Path(os.path.expanduser("~/.config/unifi/members.json"))
INTEGRATION_PREFIX = "/proxy/network/integration"


def load_members() -> dict:
    if MEMBERS_PATH.exists():
        try:
            return json.loads(MEMBERS_PATH.read_text())
        except Exception as e:
            sys.exit(f"Could not read {MEMBERS_PATH}: {e}")
    return {}


def save_members(members: dict):
    MEMBERS_PATH.parent.mkdir(parents=True, exist_ok=True)
    MEMBERS_PATH.write_text(json.dumps(members, indent=2))
    MEMBERS_PATH.chmod(0o600)


