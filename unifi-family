def _strip_for_put(p: dict) -> dict:
    """Remove read-only fields so a GET result can be PUT back."""
    out = dict(p)
    for k in ("id", "index", "metadata"):
        out.pop(k, None)
    return out


def _policy_domains(p: dict):
    df = (p.get("destination", {}).get("trafficFilter", {}) or {}).get("domainFilter")
    if not df or df.get("type") != "DOMAINS":
        sys.exit("This policy is not a domain-based rule; can't edit domains.")
    return df


def cmd_policies(args, cfg):
    api = Api(cfg)
    resolve_site_id(api, cfg)
    base = site_path(cfg, "firewall/policies")
    if args.policy_cmd == "list":
        pols = api.get_all(base)
        for p in pols:
            state = "on " if p.get("enabled") else "OFF"
            act = (p.get("action") or {}).get("type", "?")
            print(f"[{state}] {act: <6} {p.get('id','')}  {p.get('name','')}")
    elif args.policy_cmd == "get":
        print(json.dumps(api.get(f"{base}/{args.id}"), indent=2))
    elif args.policy_cmd == "delete":
        api.delete(f"{base}/{args.id}")
        print(f"Deleted policy {args.id}")
    elif args.policy_cmd in ("enable", "disable"):
        p = api.get(f"{base}/{args.id}")
        body = _strip_for_put(p)
        body["enabled"] = args.policy_cmd == "enable"
        api.put(f"{base}/{args.id}", body)
        print(f"Policy {args.id} {'enabled' if body['enabled'] else 'disabled'}")
    elif args.policy_cmd == "rename":
        p = api.get(f"{base}/{args.id}")
        body = _strip_for_put(p)
        body["name"] = args.name
        api.put(f"{base}/{args.id}", body)
        print(f"Renamed policy {args.id} -> {args.name}")
    elif args.policy_cmd in ("add-domain", "rm-domain", "set-domains"):
        p = api.get(f"{base}/{args.id}")
        body = _strip_for_put(p)
        df = _policy_domains(body)
        current = list(df.get("domains", []))
        new = [d.strip().lower() for d in args.domain if d.strip()]
        if args.policy_cmd == "set-domains":
            result = new
        elif args.policy_cmd == "add-domain":
            result = current + [d for d in new if d not in current]
        else:  # rm-domain
            result = [d for d in current if d not in new]
        if not result:
            sys.exit("Refusing to leave the rule with zero domains. Delete it instead.")
        df["domains"] = sorted(set(result))
        if args.dry_run:
            print(json.dumps(body, indent=2))
            return
        api.put(f"{base}/{args.id}", body)
        print(f"Policy {args.id} domains now: {', '.join(df['domains'])}")


def _build_block_policy(cfg, api, args, action):
    zones = api.get_all(site_path(cfg, "firewall/zones"))
    src_zone = pick_zone(zones, args.source_zone)
    dst_zone = pick_zone(zones, args.dest_zone)
    if not src_zone:
        sys.exit(
            f"Source zone '{args.source_zone}' not found. Zones: "
            + ", ".join(z["name"] for z in zones)
        )
    if not dst_zone:
        sys.exit(
            f"Dest zone '{args.dest_zone}' not found. Zones: "
            + ", ".join(z["name"] for z in zones)
        )

    # Resolve devices/members -> MAC addresses
    macs = []
    for dev in args.device:
        for mac, _label in resolve_macs(api, cfg, dev):
            if mac not in macs:
                macs.append(mac)

    domains = [d.strip().lower() for d in (args.domain or []) if d.strip()]
    cat_ids = list(args.app_category or [])
    if not domains and not cat_ids:
        sys.exit("Need at least one --domain or --app-category.")
    if domains and cat_ids:
        sys.exit("Use either --domain or --app-category in one rule, not both.")

    if cat_ids:
        dest_filter = {
            "type": "APPLICATION_CATEGORY",
            "applicationCategoryFilter": {"applicationCategoryIds": cat_ids},
        }
    else:
        dest_filter = {
            "type": "DOMAIN",
            "domainFilter": {"type": "DOMAINS", "domains": domains},
        }

    policy = {
        "name": args.name,
        "enabled": not args.disabled,
        "action": {"type": action},
        "loggingEnabled": False,
        "ipProtocolScope": {"ipVersion": "IPV4_AND_IPV6"},
        "source": {
            "zoneId": src_zone["id"],
            "trafficFilter": {
                "type": "MAC_ADDRESS",
                "macAddressFilter": {"macAddresses": macs},
            },
        },
        "destination": {
            "zoneId": dst_zone["id"],
            "trafficFilter": dest_filter,
        },
    }
    sched = build_schedule(args)
    if sched:
        policy["schedule"] = sched
    return policy


