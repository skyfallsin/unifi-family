def resolve_site_id(api: Api, cfg: Config):
    """If site == 'default' resolve to the real site id the API expects."""
    if cfg.site and cfg.site != "default":
        return cfg.site
    sites = api.get_all("/v1/sites")
    if not sites:
        sys.exit("No sites returned from the API.")
    cfg.site = sites[0]["id"]
    return cfg.site


def find_client(api: Api, cfg: Config, query: str):
    """Match a connected client by name (case-insensitive substring), MAC, or IP."""
    clients = api.get_all(site_path(cfg, "clients"))
    q = query.lower()
    matches = []
    for c in clients:
        name = (c.get("name") or "").lower()
        mac = (c.get("macAddress") or "").lower()
        ip = (c.get("ipAddress") or "").lower()
        if q == mac or q == ip or q in name:
            matches.append(c)
    return matches


DAY_NAMES = ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY"]
DAY_ALIASES = {
    "mon": "MONDAY", "tue": "TUESDAY", "tues": "TUESDAY", "wed": "WEDNESDAY",
    "thu": "THURSDAY", "thur": "THURSDAY", "thurs": "THURSDAY", "fri": "FRIDAY",
    "sat": "SATURDAY", "sun": "SUNDAY",
}


def _parse_days(spec: str):
    """'weekdays' | 'weekends' | 'everyday' | 'mon,wed,fri' -> list of DAY_NAMES."""
    s = spec.strip().lower()
    if s in ("everyday", "daily", "all"):
        return list(DAY_NAMES)
    if s == "weekdays":
        return DAY_NAMES[:5]
    if s == "weekends":
        return DAY_NAMES[5:]
    out = []
    for part in s.replace(" ", "").split(","):
        if not part:
            continue
        full = part.upper()
        if full in DAY_NAMES:
            out.append(full)
        elif part in DAY_ALIASES:
            out.append(DAY_ALIASES[part])
        else:
            sys.exit(f"Unknown day '{part}'. Use mon..sun, weekdays, weekends, or everyday.")
    # de-dupe, keep week order
    return [d for d in DAY_NAMES if d in out]


def build_schedule(args):
    """Translate scheduling flags into a firewall schedule object (or None)."""
    time_filter = None
    if args.start or args.stop:
        if not (args.start and args.stop):
            sys.exit("Provide both --start and --stop (HH:MM).")
        time_filter = {"startTime": args.start, "stopTime": args.stop}

    # One-time on a single date
    if args.date:
        return {
            "mode": "ONE_TIME_ONLY",
            "date": args.date,
            "timeFilter": time_filter or {"startTime": "00:00", "stopTime": "23:59"},
        }
    # Custom date range (optionally restricted to days of week)
    if args.start_date or args.stop_date:
        if not (args.start_date and args.stop_date):
            sys.exit("Provide both --start-date and --stop-date (YYYY-MM-DD).")
        sched = {
            "mode": "CUSTOM",
            "startDate": args.start_date,
            "stopDate": args.stop_date,
            "repeatOnDays": _parse_days(args.days) if args.days else list(DAY_NAMES),
        }
        if time_filter:
            sched["timeFilter"] = time_filter
        return sched
    # Specific days of the week
    if args.days:
        sched = {"mode": "EVERY_WEEK", "repeatOnDays": _parse_days(args.days)}
        if time_filter:
            sched["timeFilter"] = time_filter
        return sched
    # Every day within a time window
    if time_filter:
        return {"mode": "EVERY_DAY", "timeFilter": time_filter}
    return None


def pick_zone(zones, name_hint: str):
    for z in zones:
        if z.get("name", "").lower() == name_hint.lower():
            return z
    for z in zones:
        if name_hint.lower() in z.get("name", "").lower():
            return z
    return None


def resolve_macs(api, cfg, token: str, allow_member: bool = True):
    """Resolve a token to a list of (mac, label). Checks members first (unless
    allow_member is False), then a raw MAC, then a connected-client lookup.
    Supports 'member:filter' to target specific devices within a member."""
    members = load_members()

    # member:filter  -> devices of that member whose name matches filter
    if allow_member and ":" in token and len(token) != 17:
        mname, _, dfilter = token.partition(":")
        matchkey = mname.lower()
        if matchkey in {k.lower() for k in members}:
            real = next(k for k in members if k.lower() == matchkey)
            devs = members[real].get("devices", [])
            hits = [d for d in devs if dfilter.lower() in d.get("name", "").lower()
                    or dfilter.lower() == d["mac"].lower()]
            if not hits:
                sys.exit(f"No device of '{real}' matches '{dfilter}'.")
            return [(d["mac"].lower(), f"{real}:{d.get('name', d['mac'])}") for d in hits]

    key = token.lower()
    if allow_member and key in {k.lower() for k in members}:
        real = next(k for k in members if k.lower() == key)
        devs = members[real].get("devices", [])
        if not devs:
            sys.exit(f"Member '{real}' has no devices. Add one: "
                     f"unifi-family members {real} add \"Device Name\"")
        return [(d["mac"].lower(), f"{real}:{d.get('name', d['mac'])}") for d in devs]
    if ":" in token and len(token) == 17:
        return [(token.lower(), token.lower())]
    found = find_client(api, cfg, token)
    if not found:
        sys.exit(f"No member or client matched '{token}'. Run: unifi-family clients")
    if len(found) > 1:
        lines = "\n".join(f"  {c.get('macAddress')}  {c.get('name')}" for c in found)
        sys.exit(f"'{token}' matched several clients:\n{lines}\nUse a MAC.")
    c = found[0]
    return [(c["macAddress"].lower(), c.get("name", c["macAddress"]))]


