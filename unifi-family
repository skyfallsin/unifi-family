class Config:
    def __init__(self, args):
        file_cfg = {}
        if CONFIG_PATH.exists():
            try:
                file_cfg = json.loads(CONFIG_PATH.read_text())
            except Exception as e:
                sys.exit(f"Could not read {CONFIG_PATH}: {e}")

        self.base_url = (
            args.base_url
            or os.environ.get("UNIFI_BASE_URL")
            or file_cfg.get("base_url")
        )
        self.api_key = (
            args.api_key
            or os.environ.get("UNIFI_API_KEY")
            or file_cfg.get("api_key")
        )
        self.site = (
            args.site
            or os.environ.get("UNIFI_SITE")
            or file_cfg.get("site")
            or "default"
        )
        # TLS verification: local consoles use self-signed certs -> default off.
        verify = file_cfg.get("verify_tls", False)
        if args.verify_tls is not None:
            verify = args.verify_tls
        self.verify_tls = verify
        self.console_id = args.console_id or file_cfg.get("console_id")

        if not self.base_url or not self.api_key:
            sys.exit(
                "Missing base_url or api_key. Set them with:\n"
                "  unifi config --base-url https://192.168.1.1 --api-key XXXX\n"
                "or export UNIFI_BASE_URL / UNIFI_API_KEY."
            )

        if not self.verify_tls:
            urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

    def url(self, path: str) -> str:
        base = self.base_url.rstrip("/")
        if self.console_id:
            # Cloud connector form
            return (
                f"{base}/v1/connector/consoles/{self.console_id}"
                f"{INTEGRATION_PREFIX}{path}"
            )
        return f"{base}{INTEGRATION_PREFIX}{path}"

    def legacy_url(self, path: str) -> str:
        """Legacy Network API path (/proxy/network/api/...), richer client data."""
        base = self.base_url.rstrip("/")
        if self.console_id:
            return f"{base}/v1/connector/consoles/{self.console_id}/proxy/network/api{path}"
        return f"{base}/proxy/network/api{path}"


class Api:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.s = requests.Session()
        self.s.headers.update(
            {"X-API-KEY": cfg.api_key, "Accept": "application/json"}
        )
        self.s.verify = cfg.verify_tls

    def _req(self, method, path, **kw):
        url = self.cfg.url(path)
        r = self.s.request(method, url, timeout=30, **kw)
        if r.status_code >= 400:
            body = r.text
            try:
                body = json.dumps(r.json(), indent=2)
            except Exception:
                pass
            sys.exit(f"HTTP {r.status_code} {method} {path}\n{body}")
        if r.status_code == 204 or not r.text:
            return None
        return r.json()

    def get(self, path, **kw):
        return self._req("GET", path, **kw)

    def post(self, path, payload, **kw):
        return self._req("POST", path, json=payload, **kw)

    def put(self, path, payload, **kw):
        return self._req("PUT", path, json=payload, **kw)

    def patch(self, path, payload, **kw):
        return self._req("PATCH", path, json=payload, **kw)

    def delete(self, path, **kw):
        return self._req("DELETE", path, **kw)

    def legacy_get(self, path):
        url = self.cfg.legacy_url(path)
        r = self.s.get(url, timeout=30)
        if r.status_code >= 400:
            sys.exit(f"HTTP {r.status_code} GET {path}\n{r.text}")
        return r.json().get("data", [])

    # paged list helper: the API returns {data:[...], totalCount, offset, limit}
    def get_all(self, path):
        out, offset, limit = [], 0, 200
        while True:
            sep = "&" if "?" in path else "?"
            page = self.get(f"{path}{sep}offset={offset}&limit={limit}")
            if page is None:
                break
            data = page.get("data", []) if isinstance(page, dict) else page
            out.extend(data)
            total = page.get("totalCount", len(out)) if isinstance(page, dict) else len(out)
            offset += limit
            if offset >= total or not data:
                break
        return out


def site_path(cfg: Config, suffix: str) -> str:
    return f"/v1/sites/{cfg.site}/{suffix}"


