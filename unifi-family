def cmd_config(args, cfg_unused):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    existing = {}
    if CONFIG_PATH.exists():
        existing = json.loads(CONFIG_PATH.read_text())
    for k in ("base_url", "api_key", "site", "console_id"):
        v = getattr(args, k, None)
        if v is not None:
            existing[k] = v
    if args.verify_tls is not None:
        existing["verify_tls"] = args.verify_tls
    CONFIG_PATH.write_text(json.dumps(existing, indent=2))
    CONFIG_PATH.chmod(0o600)
    shown = dict(existing)
    if shown.get("api_key"):
        shown["api_key"] = shown["api_key"][:4] + "…" + shown["api_key"][-4:]
    print(f"Saved {CONFIG_PATH}:")
    print(json.dumps(shown, indent=2))


