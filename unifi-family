def _fmt_schedule(sched):
    if not sched:
        return "always"
    mode = sched.get("mode")
    tf = sched.get("timeFilter") or {}
    span = f"{tf.get('startTime','')}\u2013{tf.get('stopTime','')}" if tf else ""
    short = {"MONDAY": "Mon", "TUESDAY": "Tue", "WEDNESDAY": "Wed", "THURSDAY": "Thu",
             "FRIDAY": "Fri", "SATURDAY": "Sat", "SUNDAY": "Sun"}
    days = sched.get("repeatOnDays", [])
    days = [d for d in DAY_NAMES if d in days]  # normalize to week order
    dlabel = ""
    if days:
        if len(days) == 7:
            dlabel = "daily"
        elif days == DAY_NAMES[:5]:
            dlabel = "weekdays"
        elif days == DAY_NAMES[5:]:
            dlabel = "weekends"
        else:
            dlabel = ",".join(short.get(d, d) for d in days)
    if mode == "EVERY_DAY":
        return f"daily {span}".strip()
    if mode == "EVERY_WEEK":
        return f"{dlabel} {span}".strip()
    if mode == "ONE_TIME_ONLY":
        return f"on {sched.get('date','')} {span}".strip()
    if mode == "CUSTOM":
        rng = f"{sched.get('startDate','')}\u2192{sched.get('stopDate','')}"
        return f"{rng} {dlabel} {span}".strip()
    return mode or "always"


def _source_matches_mac(src, mac):
    """Return 'yes'/'all'/'no' for whether a policy source applies to this MAC."""
    tf = src.get("trafficFilter")
    if not tf:
        return "all"
    t = tf.get("type")
    if t == "MAC_ADDRESS":
        macs = [m.lower() for m in tf.get("macAddressFilter", {}).get("macAddresses", [])]
        return "yes" if mac in macs else "no"
    if t == "NETWORK":
        m = tf.get("macAddressFilter")
        if m:
            return "yes" if m.lower() == mac else "no"
        return "all"  # whole network -> includes this device
    return "all"


def cmd_review(args, cfg):
    api = Api(cfg)
    resolve_site_id(api, cfg)
    targets = resolve_macs(api, cfg, args.device)

    cats = {c["id"]: c["name"] for c in (api.get("/v1/dpi/categories") or {}).get("data", [])}
    apps = {}
    try:
        apps = {a.get("id"): a.get("name") for a in (api.get("/v1/dpi/applications") or {}).get("data", [])}
    except SystemExit:
        pass
    zones = {z["id"]: z["name"] for z in api.get_all(site_path(cfg, "firewall/zones"))}
    pols = api.get_all(site_path(cfg, "firewall/policies"))

    def target(dst):
        tf = dst.get("trafficFilter") or {}
        t = tf.get("type")
        if t == "DOMAIN":
            return ", ".join(tf["domainFilter"]["domains"])
        if t == "APPLICATION_CATEGORY":
            return ", ".join(cats.get(i, f"cat{i}") for i in tf["applicationCategoryFilter"]["applicationCategoryIds"])
        if t == "APPLICATION":
            return ", ".join(apps.get(i, f"app{i}") for i in tf["applicationFilter"].get("applicationIds", []))
        if t is None:
            return "everything"
        return t

    for mac, label in targets:
        rows = []
        for p in pols:
            src = p.get("source", {})
            if _source_matches_mac(src, mac) == "no":
                continue
            sz = zones.get(src.get("zoneId"), "")
            dz = zones.get(p.get("destination", {}).get("zoneId"), "")
            if not args.all and not (sz == "Internal" and dz == "External"):
                continue
            rows.append(p)
        rows.sort(key=lambda p: (p.get("index", 0)))

        scope_label = "all zone pairs" if args.all else "internet access (LAN \u2192 internet)"
        print(f"\nFirewall rules affecting {label} ({mac}) \u2014 {scope_label}")
        print("Evaluated top to bottom; the FIRST matching rule wins.\n")
        for p in rows:
            src = p.get("source", {})
            dst = p.get("destination", {})
            act = p["action"]["type"]
            when = _fmt_schedule(p.get("schedule"))
            scope = "this device" if _source_matches_mac(src, mac) == "yes" else "everyone"
            on = "" if p.get("enabled") else "  (DISABLED)"
            tgt = target(dst)
            zp = ""
            if args.all:
                zp = f" [{zones.get(src.get('zoneId'),'?')}\u2192{zones.get(dst.get('zoneId'),'?')}]"
            verb = {"ALLOW": "\u2705 ALLOW", "BLOCK": "\u26d4 BLOCK", "REJECT": "\u26d4 REJECT"}.get(act, act)
            print(f"  {verb}  {when:<22} {scope:<11} {tgt}{zp}{on}")
    print()
    print("Reminder: domain/app matching uses DPI/SNI; a VPN or DoH can evade domain rules.")


def cmd_members(args, cfg):
    a = args.args
    members = load_members()

    # members            -> list
    # members list       -> list
    if not a or (len(a) == 1 and a[0] == "list"):
        if not members:
            print("No members yet. Add one: unifi-family members add naveen kid")
            return
        by_group = {}
        for name in sorted(members):
            by_group.setdefault(members[name].get("group", "member"), []).append(name)
        for group in sorted(by_group):
            print(f"[{group}]")
            for name in by_group[group]:
                devs = members[name].get("devices", [])
                print(f"  {name}:")
                if not devs:
                    print("      (no devices)")
                for d in devs:
                    print(f"      {d['mac']: <18} {d.get('name','')}")
        return

    verbs_del = {"delete", "remove", "rm"}

    # members add <name> [group] | members delete <name>
    if a[0] == "add" and len(a) in (2, 3):
        name = a[1]
        group = a[2] if len(a) == 3 else "member"
        if name in members:
            sys.exit(f"Member '{name}' already exists.")
        members[name] = {"group": group, "devices": []}
        save_members(members)
        print(f"Added {group} '{name}'. Now attach a device: "
              f"unifi-family members {name} add \"Device Name\"")
        return
    if a[0] in verbs_del and len(a) == 2:
        name = a[1]
        if name not in members:
            sys.exit(f"No such member '{name}'.")
        del members[name]
        save_members(members)
        print(f"Deleted member '{name}'.")
        return

    # members <name> [show] | members <name> add/remove <device...>
    name = a[0]
    if name not in members:
        sys.exit(f"No such member '{name}'. Create it: unifi-family members add {name}")
    rest = a[1:]
    if not rest or rest == ["show"]:
        devs = members[name].get("devices", [])
        print(f"{name}:")
        for d in devs:
            print(f"    {d['mac']: <18} {d.get('name','')}")
        if not devs:
            print("    (no devices)")
        return

    action, targets = rest[0], rest[1:]
    if not targets:
        sys.exit(f"Usage: unifi-family members {name} {action} \"Device Name\"")
    api = Api(cfg)
    resolve_site_id(api, cfg)
    devs = members[name].setdefault("devices", [])
    existing = {d["mac"].lower() for d in devs}

    if action == "add":
        for t in targets:
            for mac, label in resolve_macs(api, cfg, t, allow_member=False):
                if mac in existing:
                    print(f"  {mac} already on '{name}'")
                    continue
                # try to get a friendly name from connected clients
                friendly = t
                hits = find_client(api, cfg, mac)
                if hits:
                    friendly = hits[0].get("name", t)
                devs.append({"mac": mac, "name": friendly})
                existing.add(mac)
                print(f"  added {mac} ({friendly}) to '{name}'")
        save_members(members)
    elif action in verbs_del:
        for t in targets:
            macs = [m for m, _ in resolve_macs(api, cfg, t, allow_member=False)] if t.lower() not in existing else [t.lower()]
            before = len(devs)
            devs[:] = [d for d in devs if d["mac"].lower() not in {m.lower() for m in macs}]
            print(f"  removed {before - len(devs)} device(s) matching '{t}' from '{name}'")
        save_members(members)
    else:
        sys.exit(f"Unknown action '{action}'. Use add or remove.")


def cmd_devices(args, cfg):
    import datetime
    api = Api(cfg)
    site = "default"  # legacy API uses the internal site name
    sta = api.legacy_get(f"/s/{site}/stat/sta")

    def ts(v):
        try:
            return datetime.datetime.fromtimestamp(v).strftime("%Y-%m-%d") if v else "-"
        except Exception:
            return "-"

    def name(c):
        return c.get("name") or c.get("hostname") or "(unnamed)"

    rows = sorted(sta, key=lambda c: name(c).lower())
    if args.filter:
        f = args.filter.lower()
        rows = [c for c in rows if f in json.dumps(c).lower()]
    for c in rows:
        mac = c.get("mac", "")
        randomized = len(mac) == 17 and mac[1] in "2367abef"  # locally-administered bit
        rtag = "  (randomized MAC)" if randomized else ""
        print(f"\n\u25cf {name(c)}   [{mac}]  {c.get('ip', c.get('last_ip','-'))}{rtag}")
        print(f"    maker: {c.get('oui') or '-'}   hostname: {c.get('hostname','-')}")
        if c.get("is_wired"):
            conn = f"wired via {c.get('last_uplink_name','-')}"
        else:
            conn = (f"wifi '{c.get('essid','-')}' via {c.get('last_uplink_name', c.get('ap_mac','-'))}"
                    f"  rssi={c.get('rssi','-')}")
        print(f"    conn: {conn}")
        print(f"    first seen {ts(c.get('first_seen'))}   last seen {ts(c.get('last_seen'))}"
              f"   fp[v{c.get('dev_vendor','?')}/f{c.get('dev_family','?')}/o{c.get('os_name','?')}/c{c.get('dev_cat','?')}]")


def cmd_block(args, cfg):
    api = Api(cfg)
    resolve_site_id(api, cfg)
    action = "ALLOW" if args.allow else "BLOCK"
    if not args.name:
        verb = "Allow" if args.allow else "Block"
        if args.app_category:
            tgt = "category " + ",".join(str(c) for c in args.app_category)
        else:
            tgt = ",".join(args.domain or [])[:30]
        args.name = f"{verb} {tgt} for {','.join(args.device)}"
    policy = _build_block_policy(cfg, api, args, action)
    if args.dry_run:
        print(json.dumps(policy, indent=2))
        return
    created = api.post(site_path(cfg, "firewall/policies"), policy)
    print(f"Created {action} policy: {created.get('id')}  {created.get('name')}")


# --------------------------------------------------------------------------- #
# Arg parsing
# --------------------------------------------------------------------------- #
def build_parser():
    p = argparse.ArgumentParser(
        prog="unifi-family",
        description="Manage UniFi firewall policies to allow/block websites per device.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent(
            """
            Examples:
              unifi-family config --base-url https://api.ui.com --api-key XXXX --console-id <id>
              unifi-family clients
              unifi-family zones
              unifi-family block "Kids iPad" --domain tiktok.com --domain youtube.com
              unifi-family block "Kids iPad" --domain roblox.com --start 21:00 --stop 07:00
              unifi-family block --allow "Kids iPad" --domain khanacademy.org
              unifi-family block "Kids iPad" --app-category 11   # VPN/proxy
              unifi-family review "Kids iPad"
              unifi-family policies list
              unifi-family policies disable <id>
              unifi-family policies delete <id>
            """
        ),
    )
    p.add_argument("--base-url")
    p.add_argument("--api-key")
    p.add_argument("--site")
    p.add_argument("--console-id", help="Cloud connector console id (optional)")
    p.add_argument(
        "--verify-tls",
        dest="verify_tls",
        action="store_true",
        default=None,
        help="Verify TLS cert (off by default for local self-signed consoles)",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    c = sub.add_parser("config", help="Save connection settings")
    c.add_argument("--base-url")
    c.add_argument("--api-key")
    c.add_argument("--site")
    c.add_argument("--console-id")
    c.add_argument("--verify-tls", dest="verify_tls", action="store_true", default=None)
    c.set_defaults(func=cmd_config, needs_cfg=False)

    s = sub.add_parser("sites", help="List sites")
    s.set_defaults(func=cmd_sites)

    cl = sub.add_parser("clients", help="List connected clients (name, MAC, IP)")
    cl.add_argument("filter", nargs="?", help="Filter substring")
    cl.set_defaults(func=cmd_clients)

    z = sub.add_parser("zones", help="List firewall zones")
    z.set_defaults(func=cmd_zones)

    dc = sub.add_parser("dpi-categories", help="List DPI application categories (ids for --app-category)")
    dc.add_argument("filter", nargs="?", help="Filter substring")
    dc.set_defaults(func=cmd_dpi_categories)

    dv = sub.add_parser("devices", help="Rich per-client detail (maker, hostname, AP, seen) for mapping")
    dv.add_argument("filter", nargs="?", help="Filter substring")
    dv.set_defaults(func=cmd_devices)

    rv = sub.add_parser("review", help="Show all firewall rules affecting a device, in evaluation order")
    rv.add_argument("device", help="Device name / MAC / IP / member")
    rv.add_argument("--all", action="store_true", help="Show every zone pair (default: only LAN\u2192internet)")
    rv.set_defaults(func=cmd_review)

    mm = sub.add_parser("members", help="Manage family members and their devices")
    mm.add_argument("args", nargs="*",
                    help="list | add <name> [group] | delete <name> | <name> [add|remove <device>]")
    mm.set_defaults(func=cmd_members)

    pol = sub.add_parser("policies", help="List/get/delete/enable/disable/edit policies")
    psub = pol.add_subparsers(dest="policy_cmd", required=True)
    psub.add_parser("list")
    for name in ("get", "delete", "enable", "disable"):
        sp = psub.add_parser(name)
        sp.add_argument("id")
    rn = psub.add_parser("rename")
    rn.add_argument("id")
    rn.add_argument("name")
    for name in ("add-domain", "rm-domain", "set-domains"):
        sp = psub.add_parser(name, help=f"{name} on an existing domain policy")
        sp.add_argument("id")
        sp.add_argument("domain", nargs="+", help="Domain(s)")
        sp.add_argument("--dry-run", action="store_true")
    pol.set_defaults(func=cmd_policies)

    b = sub.add_parser("block", help="Create a policy blocking (or allowing) domains for a device")
    b.add_argument("device", nargs="+", help="Device name / MAC / IP (one or more)")
    b.add_argument("--domain", action="append", help="Domain to match (repeatable)")
    b.add_argument("--app-category", type=int, action="append", help="DPI category id to match (repeatable). See: unifi dpi-categories")
    b.add_argument("--allow", action="store_true", help="Make it an ALLOW rule instead of BLOCK")
    b.add_argument("--name", help="Policy name")
    b.add_argument("--source-zone", default="Internal", help="Source zone name (default: Internal)")
    b.add_argument("--dest-zone", default="External", help="Destination zone name (default: External)")
    b.add_argument("--start", help="Active window start HH:MM")
    b.add_argument("--stop", help="Active window stop HH:MM")
    b.add_argument("--days", help="Days of week: mon,wed,fri | weekdays | weekends | everyday")
    b.add_argument("--date", help="One-time only on YYYY-MM-DD")
    b.add_argument("--start-date", dest="start_date", help="Custom range start YYYY-MM-DD")
    b.add_argument("--stop-date", dest="stop_date", help="Custom range stop YYYY-MM-DD")
    b.add_argument("--disabled", action="store_true", help="Create disabled")
    b.add_argument("--dry-run", action="store_true", help="Print payload, don't send")
    b.set_defaults(func=cmd_block)

    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if getattr(args, "needs_cfg", True) is False:
        args.func(args, None)
        return
    cfg = Config(args)
    args.func(args, cfg)


if __name__ == "__main__":
    main()
